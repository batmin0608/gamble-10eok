{
  "rules": {
    "lobby": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('t').isNumber())"
      }
    },
    "rooms": {
      "$code": {
        ".write": "auth != null && data.exists() && data.child('host/uid').val() === auth.uid && !newData.exists()",
        "host": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('bal').isNumber())"
        },
        "guest": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && root.child('rooms').child($code).child('host').exists()) || data.child('uid').val() === auth.uid || (!newData.exists() && root.child('rooms').child($code).child('host/uid').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('bal').isNumber())"
        },
        "state": {
          ".read": "auth != null && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)",
          ".write": "auth != null && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)"
        },
        "ready": {
          ".read": "auth != null && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)",
          ".write": "auth != null && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)"
        },
        "dealt": {
          ".read": "auth != null && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)",
          ".write": "auth != null && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)"
        },
        "chat": {
          ".read": "auth != null && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)",
          "$id": {
            ".write": "!data.exists() && auth != null && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)",
            ".validate": "newData.child('x').isString() && newData.child('x').val().length <= 100"
          }
        },
        "cards": {
          "$hk": {
            "$seat": {
              ".read": "auth != null && (($seat === '0' && root.child('rooms').child($code).child('guest/uid').val() === auth.uid) || ($seat === '1' && root.child('rooms').child($code).child('host/uid').val() === auth.uid) || (root.child('rooms').child($code).child('state/phase').val() === 'end' && root.child('rooms').child($code).child('state/hk').val() === $hk && (root.child('rooms').child($code).child('host/uid').val() === auth.uid || root.child('rooms').child($code).child('guest/uid').val() === auth.uid)))",
              ".write": "auth != null && !data.exists() && (($seat === '0' && root.child('rooms').child($code).child('guest/uid').val() === auth.uid) || ($seat === '1' && root.child('rooms').child($code).child('host/uid').val() === auth.uid))"
            }
          }
        }
      }
    }
  }
}
